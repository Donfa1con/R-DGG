{
  "metric": "R-DGG shift-correction ablation",
  "question": "is the time-shift correction (net = g_a_m - g_shift) needed?",
  "source": "combo",
  "suffix": "emoca",
  "split": "LS_AL",
  "n_folds": 4,
  "mask_mode": "common",
  "mask": "ONE shared mask = GT-reactive & every model-seed column's face_ok; all columns score on IDENTICAL frames (surrogate excluded from the intersection, like the leaderboard; its seam-blinding then applies on top)",
  "arithmetic": {
    "g_a_m": "1e4 * log(mot_r/both_r)  -- aligned gain, UNCORRECTED",
    "g_shift": "1e4 * mean_k log(mot_n[k]/both_n[k])  -- mean of 100 time-shift nulls",
    "net": "g_a_m - g_shift  -- R-DGG, CORRECTED",
    "ci": "identity-clustered bootstrap, B=20000, one-sided p=P(draw<=0)"
  },
  "controls": {
    "GT": "held-out positive control (must react, net>0)",
    "GT\u00d7other": "GT motion under a wrong pairing (negative control, must read ~0)",
    "non-dyad": "talking-head models with real audio but no dyadic reaction (must read ~0)"
  },
